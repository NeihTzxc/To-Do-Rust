{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rust-task-mgr",
  "version": "0.1.0",
  "identifier": "com.antigravity.taskmgr",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TickTask - Task Manager",
        "width": 1150,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true
  }
}
